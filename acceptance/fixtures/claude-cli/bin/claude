#!/usr/bin/env node
// acceptance/fixtures/claude-cli/bin/claude — FAUX EXECUTABLE, zone ACCEPTANCE.
//
// Remplace la vraie CLI `claude` pour acceptance/T47.spec.ts (et pour toute
// autre suite qui la placerait en tete de PATH) : ADR-008 (L96-L100, L135
// T47.A... /commande) "Un faux executable `claude` place en tete du PATH rend
// des sorties enregistrees [...] Les verifications le passent avec le faux
// executable ; l'essai reel, avec la vraie CLI, n'a lieu que sur demande du
// mandant." Ce fichier est CE faux executable : il ne fait jamais de reseau,
// jamais d'appel reel, et ne depend d'aucune authentification.
//
// Delibere : ni `import` ni `require` au niveau superieur, pour rester
// valide que Node le charge en ESM ou en CJS (determine par le `type` du
// package.json le plus proche, hors du controle de cette suite). Seuls des
// globaux (`process`) et un `import()` dynamique (valide dans les deux
// systemes de module) sont utilises.
//
// Pilotage PAR VARIABLE D'ENVIRONNEMENT (le canal que l'adaptateur sous test
// doit laisser passer : seules ANTHROPIC_API_KEY et ANTHROPIC_AUTH_TOKEN sont
// censees etre retirees par T47.A1) :
//   BENCH_FAKE_CLAUDE_AUTH_MARKER_FILE  — ecrit quand l'argv contient
//                                         "auth status" (preuve que le
//                                         controle a reellement eu lieu).
//   BENCH_FAKE_CLAUDE_AUTH_METHOD       — valeur de authMethod rendue
//                                         (defaut 'oauth_token').
//   BENCH_FAKE_CLAUDE_AUTH_PROVIDER     — valeur de apiProvider rendue
//                                         (defaut 'firstParty').
//   BENCH_FAKE_CLAUDE_RECORD_FILE       — ecrit pour tout appel qui N'EST PAS
//                                         "auth status" (une session) : argv,
//                                         cwd, et la PRESENCE (pas la valeur)
//                                         de ANTHROPIC_API_KEY/
//                                         ANTHROPIC_AUTH_TOKEN dans son propre
//                                         environnement.
//   BENCH_FAKE_CLAUDE_STDOUT_RAW        — ecrit tel quel sur stdout au lieu
//                                         du JSON "success" par defaut.
//   BENCH_FAKE_CLAUDE_EXIT_CODE         — code de sortie (defaut '0').
//
// AJOUTE PAR acceptance/T49.spec.ts (ADDITIF — ne change AUCUN comportement
// par defaut existant pour acceptance/T47.spec.ts, qui ne pose jamais ces
// deux variables) :
//   BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_RELPATH   — chemin RELATIF (sous le cwd
//                                         de CET appel, donc sous l'espace de
//                                         travail que l'appelant a derive,
//                                         ADR-008:L89-91) ou ecrire un fichier
//                                         avant de repondre — simule le code
//                                         qu'une VRAIE session `claude -p`
//                                         aurait ecrit avec ses propres outils
//                                         (lecture/edition de fichiers),
//                                         jamais le protocole NDJSON (T48,
//                                         hors de portee de ce fixture).
//   BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_CONTENT   — contenu ecrit a ce chemin.
//   Les deux DOIVENT etre fournies ensemble pour que l'ecriture ait lieu ;
//   absence de l'une ou l'autre : aucune ecriture, comportement T47 inchange.
//   N'a jamais lieu sur un appel "auth status" (seule une session en a besoin).
//
// AJOUTE PAR acceptance/T52.spec.ts (ADDITIF — ne change AUCUN comportement
// existant pour T47/T49/T50/T51, qui ne posent jamais ces deux variables ;
// le PAIR RELPATH/CONTENT ci-dessus reste prioritaire si present) :
//   BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_PLAN_FILE          — chemin d'un fichier
//                                         JSON contenant un tableau
//                                         `{relPath, content}[]`. Necessaire
//                                         parce que l'environnement d'UN
//                                         appel CLI est le MEME pour TOUTES
//                                         les invocations de ce faux
//                                         executable qu'il engendre pendant
//                                         cet appel (une periode par
//                                         invocation, plusieurs periodes par
//                                         appel de `pilot-conduct`) : le pair
//                                         RELPATH/CONTENT seul ne peut donc
//                                         PAS faire ecrire un contenu
//                                         DIFFERENT a la periode 2 de celui
//                                         de la periode 1 au sein d'un MEME
//                                         appel.
//   BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_PLAN_COUNTER_FILE  — chemin d'un fichier
//                                         compteur (entier decimal en texte,
//                                         absent ou illisible == 0). Lu AVANT
//                                         d'ecrire, pour choisir
//                                         `plan[min(compteur, plan.length-1)]`,
//                                         puis incremente de 1 et reecrit —
//                                         de sorte que la Nieme invocation de
//                                         CET appel CLI qui partage ce MEME
//                                         fichier compteur applique le Nieme
//                                         element du plan (le dernier element
//                                         se repete au-dela de sa longueur,
//                                         jamais une erreur).
//   Les deux DOIVENT etre fournies ensemble ; absence de l'une ou l'autre,
//   ou PRESENCE simultanee du pair RELPATH/CONTENT ci-dessus (qui reste
//   prioritaire) : aucune ecriture par ce mecanisme, comportement T47/T49
//   inchange.
//
// AJOUTE PAR acceptance/T55.spec.ts (ADDITIF — ne change AUCUN comportement
// existant pour T47/T49/T50/T51/T52/T54, qui ne posent jamais ces deux
// variables ; le simple `BENCH_FAKE_CLAUDE_RECORD_FILE` ci-dessus reste
// INCHANGE et continue d'ecraser a chaque invocation) :
//   BENCH_FAKE_CLAUDE_RECORD_FILE_PLAN_DIR           — repertoire dans lequel
//                                         ecrire UN enregistrement DISTINCT
//                                         (meme forme que RECORD_FILE : argv,
//                                         cwd, hasApiKey, hasAuthToken) par
//                                         invocation de session successive,
//                                         au chemin `record-<n>.json` (n
//                                         demarrant a 0). NECESSAIRE parce que
//                                         RECORD_FILE seul est ECRASE a
//                                         chaque invocation (dernier
//                                         survivant seulement) : une suite
//                                         qui doit observer le prompt REELLEMENT
//                                         recu par la session de CHAQUE periode
//                                         d'UN MEME appel `pilot-conduct`
//                                         (plusieurs invocations de ce faux
//                                         executable partageant le MEME
//                                         environnement) ne peut pas,
//                                         sinon, distinguer la periode 1 de
//                                         la periode 2 (meme limite que celle
//                                         deja nommee pour
//                                         WORKSPACE_WRITE_PLAN, T52).
//   BENCH_FAKE_CLAUDE_RECORD_FILE_PLAN_COUNTER_FILE  — fichier compteur
//                                         (entier decimal en texte, absent ou
//                                         illisible == 0) propre a CE
//                                         mecanisme (JAMAIS partage avec
//                                         BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_
//                                         PLAN_COUNTER_FILE, qui compte un
//                                         evenement different) : lu AVANT
//                                         d'ecrire pour choisir `n`, puis
//                                         incremente de 1 et reecrit.
//   Les deux DOIVENT etre fournies ensemble ; absence de l'une ou l'autre :
//   aucune ecriture par ce mecanisme, comportement T47/T49/T52/T54 inchange.
//   Independant de BENCH_FAKE_CLAUDE_RECORD_FILE : les DEUX peuvent etre
//   fournies ensemble sans interference (chacun ecrit a son propre chemin).
//   N'a jamais lieu sur un appel "auth status" (meme garde que RECORD_FILE,
//   ci-dessus : ce bloc est place APRES le retour anticipe de cette branche).
//
// AJOUTE PAR acceptance/T55.spec.ts, cas A3 (ADDITIF — ne change AUCUN
// comportement existant pour T47/T49/T50/T51/T52/T54, qui ne posent jamais
// ces variables ; le pair RELPATH/CONTENT reste prioritaire, puis ce
// mecanisme, puis le PLAN de T52) :
//   BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_MODULE  — chemin d'un module ESM qui
//                                         exporte `deriver({prompt, cwd, fs,
//                                         path}) -> {relPath, content,
//                                         params}`. Le faux executable lui
//                                         passe le prompt RECU par CETTE
//                                         invocation (l'argument qui suit
//                                         `-p`, '' s'il manque) et ecrit
//                                         `content` a `relPath` sous le cwd.
//                                         NECESSAIRE pour T55.A3 (« un
//                                         candidat de reference conforme AU
//                                         SEUL PROMPT RECU ») : un contenu
//                                         FIXE (RELPATH/CONTENT, PLAN) ne
//                                         depend pas du prompt et ne peut
//                                         donc pas prouver que le prompt
//                                         suffit. Module de T55 :
//                                         acceptance/fixtures/claude-cli/
//                                         t55-derive-reference-candidate.mjs.
//   BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_LOG_DIR — optionnel : repertoire ou
//                                         ecrire `derived-<n>.json` ({prompt,
//                                         cwd, relPath, content, params}) par
//                                         invocation successive (compteur
//                                         propre `counter.txt` dans ce
//                                         repertoire), et `errors.log` si la
//                                         derivation echoue.
//
// AJOUTE PAR acceptance/T76.spec.ts (ADDITIF — ne change AUCUN comportement
// existant : aucun module de derivation anterieur (T55..T73) ne rend de champ
// `stdout`) :
//   Si le module de BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_MODULE rend, en plus de
//   `{relPath, content, params}`, un champ `stdout` de type texte, ce texte est
//   ecrit sur stdout A LA PLACE du JSON « success » par defaut (comme
//   BENCH_FAKE_CLAUDE_STDOUT_RAW, qui reste PRIORITAIRE s'il est pose).
//   NECESSAIRE pour T76 : les comptes de tokens, de tours et la duree que rend
//   une session doivent dependre du bras, de la trajectoire et de la periode
//   (rapport des couts du bras B sur le bras A), alors que STDOUT_RAW est le
//   MEME pour toutes les invocations d'un appel `pilot-conduct`.

const argv = process.argv.slice(2);

function isAuthStatus(a) {
  return a.includes('auth') && a.includes('status');
}

async function main() {
  const fs = await import('node:fs');

  if (isAuthStatus(argv)) {
    const marker = process.env.BENCH_FAKE_CLAUDE_AUTH_MARKER_FILE;
    if (marker) {
      try {
        fs.writeFileSync(marker, JSON.stringify({ argv, at: Date.now() }));
      } catch {
        /* la preuve d'invocation n'est pas l'objet de cette branche */
      }
    }
    const authMethod = process.env.BENCH_FAKE_CLAUDE_AUTH_METHOD || 'oauth_token';
    const apiProvider = process.env.BENCH_FAKE_CLAUDE_AUTH_PROVIDER || 'firstParty';
    process.stdout.write(JSON.stringify({ authMethod, apiProvider }));
    process.exitCode = 0;
    return;
  }

  const recordFile = process.env.BENCH_FAKE_CLAUDE_RECORD_FILE;
  if (recordFile) {
    const record = {
      argv,
      cwd: process.cwd(),
      hasApiKey: Object.prototype.hasOwnProperty.call(process.env, 'ANTHROPIC_API_KEY'),
      hasAuthToken: Object.prototype.hasOwnProperty.call(process.env, 'ANTHROPIC_AUTH_TOKEN'),
    };
    try {
      fs.writeFileSync(recordFile, JSON.stringify(record));
    } catch {
      /* la preuve d'invocation n'est pas l'objet de cette branche */
    }
  }

  // acceptance/T55.spec.ts (ADDITIF, voir en-tete) : UN enregistrement DISTINCT
  // par invocation successive, jamais ecrase par l'invocation suivante —
  // independant du pair RECORD_FILE ci-dessus (les deux peuvent coexister).
  const recordPlanDir = process.env.BENCH_FAKE_CLAUDE_RECORD_FILE_PLAN_DIR;
  const recordPlanCounterFile = process.env.BENCH_FAKE_CLAUDE_RECORD_FILE_PLAN_COUNTER_FILE;
  if (recordPlanDir !== undefined && recordPlanCounterFile !== undefined) {
    try {
      const path = await import('node:path');
      let compteur = 0;
      try {
        compteur = Number.parseInt(fs.readFileSync(recordPlanCounterFile, 'utf8').trim(), 10);
        if (!Number.isFinite(compteur) || compteur < 0) compteur = 0;
      } catch {
        compteur = 0;
      }
      const record = {
        argv,
        cwd: process.cwd(),
        hasApiKey: Object.prototype.hasOwnProperty.call(process.env, 'ANTHROPIC_API_KEY'),
        hasAuthToken: Object.prototype.hasOwnProperty.call(process.env, 'ANTHROPIC_AUTH_TOKEN'),
      };
      fs.mkdirSync(recordPlanDir, { recursive: true });
      fs.writeFileSync(path.join(recordPlanDir, `record-${compteur}.json`), JSON.stringify(record));
      fs.mkdirSync(path.dirname(path.resolve(recordPlanCounterFile)), { recursive: true });
      fs.writeFileSync(recordPlanCounterFile, String(compteur + 1));
    } catch {
      /* capture du prompt par periode : un echec ici n'est pas l'objet de cette branche */
    }
  }

  let derivedStdout; // acceptance/T76.spec.ts (ADDITIF) : `stdout` rendu par le module de derivation
  const writeRelPath = process.env.BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_RELPATH;
  const writeContent = process.env.BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_CONTENT;
  if (writeRelPath !== undefined && writeContent !== undefined) {
    try {
      const path = await import('node:path');
      const dest = path.resolve(process.cwd(), writeRelPath);
      fs.mkdirSync(path.dirname(dest), { recursive: true });
      fs.writeFileSync(dest, writeContent);
    } catch {
      /* simulation d'ecriture du candidat : un echec ici n'est pas l'objet de cette branche */
    }
  } else if (process.env.BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_MODULE !== undefined) {
    // acceptance/T55.spec.ts, A3 (ADDITIF, voir en-tete) : le candidat ecrit est DERIVE du
    // prompt RECU par CETTE invocation — jamais un contenu fixe a l'avance.
    const deriveLogDir = process.env.BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_LOG_DIR;
    try {
      const path = await import('node:path');
      const url = await import('node:url');
      const idxP = argv.indexOf('-p');
      const prompt = idxP >= 0 && idxP + 1 < argv.length ? argv[idxP + 1] : '';
      const mod = await import(url.pathToFileURL(path.resolve(process.env.BENCH_FAKE_CLAUDE_WORKSPACE_DERIVE_MODULE)).href);
      const derive = mod.deriver({ prompt, cwd: process.cwd(), fs, path });
      const dest = path.resolve(process.cwd(), derive.relPath);
      fs.mkdirSync(path.dirname(dest), { recursive: true });
      fs.writeFileSync(dest, derive.content);
      // acceptance/T76.spec.ts (ADDITIF, voir en-tete) : sortie propre a CETTE invocation.
      if (derive !== null && typeof derive === 'object' && typeof derive.stdout === 'string') derivedStdout = derive.stdout;
      if (deriveLogDir !== undefined) {
        fs.mkdirSync(deriveLogDir, { recursive: true });
        const counterFile = path.join(deriveLogDir, 'counter.txt');
        let compteur = 0;
        try {
          compteur = Number.parseInt(fs.readFileSync(counterFile, 'utf8').trim(), 10);
          if (!Number.isFinite(compteur) || compteur < 0) compteur = 0;
        } catch {
          compteur = 0;
        }
        fs.writeFileSync(
          path.join(deriveLogDir, `derived-${compteur}.json`),
          JSON.stringify({ prompt, cwd: process.cwd(), relPath: derive.relPath, content: derive.content, params: derive.params }),
        );
        fs.writeFileSync(counterFile, String(compteur + 1));
      }
    } catch (e) {
      if (deriveLogDir !== undefined) {
        try {
          fs.mkdirSync(deriveLogDir, { recursive: true });
          fs.appendFileSync(`${deriveLogDir}/errors.log`, `${String(e && e.stack ? e.stack : e)}\n`);
        } catch {
          /* journal d'erreur : jamais une condition de reponse */
        }
      }
    }
  } else {
    // acceptance/T52.spec.ts (ADDITIF, voir en-tete) : un PLAN d'ecritures, une par
    // invocation partageant le MEME fichier compteur — jamais engage si le pair
    // RELPATH/CONTENT ci-dessus est present.
    const planFile = process.env.BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_PLAN_FILE;
    const counterFile = process.env.BENCH_FAKE_CLAUDE_WORKSPACE_WRITE_PLAN_COUNTER_FILE;
    if (planFile !== undefined && counterFile !== undefined) {
      try {
        const path = await import('node:path');
        const plan = JSON.parse(fs.readFileSync(planFile, 'utf8'));
        if (Array.isArray(plan) && plan.length > 0) {
          let compteur = 0;
          try {
            compteur = Number.parseInt(fs.readFileSync(counterFile, 'utf8').trim(), 10);
            if (!Number.isFinite(compteur) || compteur < 0) compteur = 0;
          } catch {
            compteur = 0;
          }
          const idx = Math.min(compteur, plan.length - 1);
          const entree = plan[idx];
          if (entree && typeof entree.relPath === 'string' && typeof entree.content === 'string') {
            const dest = path.resolve(process.cwd(), entree.relPath);
            fs.mkdirSync(path.dirname(dest), { recursive: true });
            fs.writeFileSync(dest, entree.content);
          }
          fs.mkdirSync(path.dirname(path.resolve(counterFile)), { recursive: true });
          fs.writeFileSync(counterFile, String(compteur + 1));
        }
      } catch {
        /* simulation d'ecriture du candidat : un echec ici n'est pas l'objet de cette branche */
      }
    }
  }

  const rawOverride = process.env.BENCH_FAKE_CLAUDE_STDOUT_RAW;
  const exitCodeRaw = process.env.BENCH_FAKE_CLAUDE_EXIT_CODE;
  const exitCode = exitCodeRaw === undefined ? 0 : Number.parseInt(exitCodeRaw, 10);

  if (rawOverride !== undefined) {
    process.stdout.write(rawOverride);
  } else if (derivedStdout !== undefined) {
    process.stdout.write(derivedStdout);
  } else {
    process.stdout.write(
      JSON.stringify({
        type: 'result',
        subtype: 'success',
        is_error: false,
        session_id: 'bench-fake-session',
        num_turns: 1,
        total_cost_usd: 0,
        usage: {
          input_tokens: 0,
          output_tokens: 0,
          cache_creation_input_tokens: 0,
          cache_read_input_tokens: 0,
        },
        modelUsage: {},
      }),
    );
  }
  process.exitCode = Number.isFinite(exitCode) ? exitCode : 0;
}

main();
